# 复制本文件为 .env（.env 已被 .gitignore 忽略，不会提交到仓库）
# 把 CHANGE_ME 换成你自己的值
POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME

# MinIO 对象存储。密码未填写时 Compose 会临时复用 SECRET_KEY；建议单独设置。
MINIO_ROOT_USER=streamhub
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=streamhub-media

# 默认端口。只运行一个副本时无需修改；并行启动多个副本时每个项目必须使用不同端口。
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
SRS_RTMP_HOST_PORT=1935
SRS_HTTP_HOST_PORT=8080

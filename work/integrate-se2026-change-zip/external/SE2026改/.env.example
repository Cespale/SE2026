# 复制本文件为 .env（.env 已被 .gitignore 忽略，不会提交到仓库）
# 把 CHANGE_ME 换成你自己的值
POSTGRES_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

E2E_BACKEND_PYTHON=.venv\Scripts\python.exe

# MinIO 对象存储。密码未填写时 Compose 会临时复用 SECRET_KEY；建议单独设置。
MINIO_ROOT_USER=streamhub
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=streamhub-media
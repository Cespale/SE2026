POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=streamhub
USER_SERVICE_DB_PASSWORD=replace-with-a-different-strong-password
CONTENT_SERVICE_DB_PASSWORD=replace-with-a-different-strong-password
SOCIAL_SERVICE_DB_PASSWORD=replace-with-a-different-strong-password
USER_DATABASE_URL=postgresql://streamhub_user_service:replace-user-password@postgres-ms:5432/streamhub
CONTENT_DATABASE_URL=postgresql://streamhub_content_service:replace-content-password@postgres-ms:5432/streamhub
SOCIAL_DATABASE_URL=postgresql://streamhub_social_service:replace-social-password@postgres-ms:5432/streamhub
SECRET_KEY=replace-with-a-long-random-local-secret
APP_VERSION=1.0.0
MINIO_ROOT_USER=streamhub-ms
MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-password
MINIO_BUCKET=streamhub-media
SERVICE_CONNECT_TIMEOUT_SECONDS=0.5
SERVICE_TOTAL_TIMEOUT_SECONDS=1.5
USER_SERVICE_URL=http://user-service:8000
CONTENT_SERVICE_URL=http://content-service:8000
SOCIAL_SERVICE_URL=http://social-service:8000
SRS_PUBLIC_RTMP_BASE=rtmp://localhost:1936/live
SRS_PUBLIC_HTTP_BASE=http://localhost:8081/live
